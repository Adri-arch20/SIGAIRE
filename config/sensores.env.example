# Copia a config/sensores.env y modifica la IP del ESP32.
# La Raspberry y el ESP32 deben estar en la misma red.
METEOBOT_ESP32_IP=192.168.137.200
SIGAIRE_SENSORS_URL=http://127.0.0.1:5000/api/sensores/esp32
METEOBOT_SENSOR_INTERVAL=0.5
METEOBOT_SENSOR_TIMEOUT=1.0

# SDS011 conectado directamente a la Raspberry Pi.
# Déjalo vacío para autodetectar /dev/serial/by-id/* o /dev/ttyUSB0.
SDS011_PORT=
SALUD_AMBIENTAL_SDS011_URL=http://127.0.0.1:5000/api/sensores/sds011
SDS011_PUBLISH_INTERVAL=0.5
